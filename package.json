{
  "name": "chess",
  "version": "0.2.91",
  "description": "6D Chess - multiverse chess with timeline branching",
  "main": "dist/bundle.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "serve": "node scripts/serve.js 8000",
    "dev": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammcgrail/6Dchess.git"
  },
  "keywords": [
    "chess",
    "3d",
    "three.js",
    "multiverse"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sammcgrail/6Dchess/issues"
  },
  "homepage": "https://github.com/sammcgrail/6Dchess#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.2.3",
    "@types/three": "^0.182.0",
    "chess.js": "^0.10.3",
    "esbuild": "^0.27.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
